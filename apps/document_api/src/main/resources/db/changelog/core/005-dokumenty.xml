<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Metadane dokumentów w `core` (document_api); treść plików i wersje techniczne
         szablonów/dokumentów żyją w schemie `dms` (dms_service) - zob. main_assumptions.md sekcja 4. -->

    <changeSet id="005-01-typ-dokumentu" author="robert_neat">
        <createTable tableName="typ_dokumentu">
            <column name="id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nazwa" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="opis" type="varchar(1024)"/>
        </createTable>
    </changeSet>

    <changeSet id="005-02-szablon-jasper" author="robert_neat">
        <createTable tableName="szablon_jasper">
            <column name="id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="typ_dokumentu_id" type="varchar(64)">
                <constraints nullable="false"
                             foreignKeyName="fk_szablon_typ_dokumentu" references="typ_dokumentu(id)"/>
            </column>
            <column name="nazwa" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="wersja" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="data_wgrania" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="autor" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="005-03-dokument" author="robert_neat">
        <createTable tableName="dokument">
            <column name="id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sprawa_id" type="varchar(64)">
                <constraints nullable="false"
                             foreignKeyName="fk_dokument_sprawa" references="sprawa(id)"/>
            </column>
            <column name="typ_dokumentu_id" type="varchar(64)">
                <constraints nullable="false"
                             foreignKeyName="fk_dokument_typ_dokumentu" references="typ_dokumentu(id)"/>
            </column>
            <column name="nazwa" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="aktualna_wersja" type="int" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="data_utworzenia" type="date">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="dokument" indexName="ix_dokument_sprawa_id">
            <column name="sprawa_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="005-04-wersja-dokumentu" author="robert_neat">
        <createTable tableName="wersja_dokumentu">
            <column name="id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="dokument_id" type="varchar(64)">
                <constraints nullable="false"
                             foreignKeyName="fk_wersja_dokumentu_dokument" references="dokument(id)"/>
            </column>
            <column name="wersja" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="podpisana" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="data_utworzenia" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="autor" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="status_podpisu" type="varchar(32)" defaultValue="brak">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="wersja_dokumentu" columnNames="dokument_id, wersja"
                              constraintName="uq_wersja_dokumentu_dokument_wersja"/>
    </changeSet>

    <changeSet id="005-05-wersja-dokumentu-ck-status-podpisu" author="robert_neat">
        <sql>ALTER TABLE wersja_dokumentu ADD CONSTRAINT ck_wersja_dokumentu_status_podpisu CHECK (status_podpisu in ('brak', 'poprawny', 'niepoprawny', 'certyfikat_wygasly', 'certyfikat_uniewazniony'))</sql>
        <rollback>ALTER TABLE wersja_dokumentu DROP CONSTRAINT ck_wersja_dokumentu_status_podpisu</rollback>
    </changeSet>

</databaseChangeLog>
