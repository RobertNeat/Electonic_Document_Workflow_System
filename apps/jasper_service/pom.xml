<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>robert_neat</groupId>
    <artifactId>jasper_service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>jasper_service</name>
    <description>jasper_service</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <!-- 7.0.6, nie 7.0.7+/7.1.0: od 7.0.7 jasperreports-pdf wymaga com.github.librepdf:openpdf w
             wersji z suffixem .jaspersoftN, dostępnej tylko w repozytorium Jaspersoft, nie w Maven
             Central / lokalnym mirrorze. 7.0.6 to najwyższa wersja z plain openpdf:1.3.43 z Central -
             usuwa CVE-2025-10492, ale nie CVE-2026-6009 (patrz Trivy_exceptions w projects.json). -->
        <jasperreports.version>7.0.6</jasperreports.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- CVE-2024-47554: pin na wypadek obniżenia wersji przez przyszłą zmianę jasperreports.version -
                 7.0.6 już rozwiązuje commons-io do tej wersji tranzytywnie (przez batik-bridge), ale bez
                 jawnego zarządzania podatna 2.11.0 z jasperreports 7.0.3 mogłaby wrócić przy downgrade'ie -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.19.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports</artifactId>
            <version>${jasperreports.version}</version>
        </dependency>
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports-pdf</artifactId>
            <version>${jasperreports.version}</version>
        </dependency>
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports-fonts</artifactId>
            <version>${jasperreports.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
