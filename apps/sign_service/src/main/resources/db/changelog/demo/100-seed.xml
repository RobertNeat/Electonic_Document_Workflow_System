<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Dane demonstracyjne PKI: certyfikat aktywny referenta (demo.referent / Katarzyna
         Zielińska), certyfikat wygasły i certyfikat unieważniony (dla urozmaicenia), wystawiony
         podpis odpowiadający wd-2 z seeda `core` (status_podpisu='poprawny' w
         core.wersja_dokumentu) oraz wpis unieważnienia demonstrujący mechanizm CRL/OCSP mock.
         Context "demo" - nie uruchamia się na produkcji bez jawnego dopisania tego kontekstu
         do spring.liquibase.contexts. -->

    <changeSet id="100-01-certyfikaty" author="robert_neat" context="demo">
        <insert tableName="certyfikat">
            <column name="id" value="cert-1"/>
            <column name="podmiot" value="CN=Katarzyna Zielińska, O=Urząd, C=PL"/>
            <column name="numer_seryjny" value="7A3F1B2C9D0E4455"/>
            <column name="data_wydania" valueDate="2026-01-10"/>
            <column name="data_wygasniecia" valueDate="2027-01-10"/>
            <column name="status" value="aktywny"/>
            <column name="wydawca" value="Demo CA Issuing"/>
        </insert>
        <insert tableName="certyfikat">
            <column name="id" value="cert-2"/>
            <column name="podmiot" value="CN=Piotr Lewandowski, O=Urząd, C=PL"/>
            <column name="numer_seryjny" value="11F0C3A4B5D6E788"/>
            <column name="data_wydania" valueDate="2024-05-15"/>
            <column name="data_wygasniecia" valueDate="2025-05-15"/>
            <column name="status" value="wygasly"/>
            <column name="wydawca" value="Demo CA Issuing"/>
        </insert>
        <insert tableName="certyfikat">
            <column name="id" value="cert-3"/>
            <column name="podmiot" value="CN=Marta Wiśniewska, O=Urząd, C=PL"/>
            <column name="numer_seryjny" value="99AA88BB77CC66DD"/>
            <column name="data_wydania" valueDate="2026-02-01"/>
            <column name="data_wygasniecia" valueDate="2027-02-01"/>
            <column name="status" value="uniewazniony"/>
            <column name="wydawca" value="Demo CA Issuing"/>
        </insert>
    </changeSet>

    <changeSet id="100-02-wystawione-podpisy" author="robert_neat" context="demo">
        <insert tableName="wystawiony_podpis">
            <column name="id" value="wp-1"/>
            <column name="certyfikat_id" value="cert-1"/>
            <column name="dokument_referencja" value="wd-2"/>
            <column name="format" value="pades"/>
            <column name="data_podpisania" valueDate="2026-10-05T00:00:00+00:00"/>
            <column name="znacznik_czasu" value="TSA-DEMO-20261005000000-0001"/>
            <column name="status_weryfikacji" value="poprawny"/>
        </insert>
    </changeSet>

    <changeSet id="100-03-uniewaznienia" author="robert_neat" context="demo">
        <insert tableName="uniewaznienie">
            <column name="id" value="un-1"/>
            <column name="certyfikat_id" value="cert-3"/>
            <column name="data_uniewaznienia" valueDate="2026-09-20T00:00:00+00:00"/>
            <column name="powod" value="key_compromise"/>
        </insert>
    </changeSet>

</databaseChangeLog>
