# on server this file is config.env

# === PostgreSQL (jedna instancja, kontener "postgres", schema per serwis) ===
# EDWS_DB_NAME - nazwa bazy danych (POSTGRES_DB); wymagane, brak wartości przerywa start postgres
# EDWS_DB_ADMIN_USER - użytkownik administracyjny instancji (POSTGRES_USER); wymagane
# EDWS_DB_ADMIN_PASSWORD - hasło użytkownika administracyjnego (POSTGRES_PASSWORD); wymagane, zmienić na serwerze
EDWS_DB_NAME=electronic_document_workflow
EDWS_DB_ADMIN_USER=edws_admin
EDWS_DB_ADMIN_PASSWORD=change-me

# === document_api (rola/schema "core" w instancji postgres) ===
# DOCUMENT_API_DB_USER - rola bazy danych tworzona przez pg-init dla document_api (schema "core"); wymagane
# DOCUMENT_API_DB_PASSWORD - hasło tej roli (SPRING_DATASOURCE_PASSWORD document_api); wymagane, zmienić na serwerze
DOCUMENT_API_DB_USER=document_api
DOCUMENT_API_DB_PASSWORD=change-me

# === dms_service (rola/schema "dms" w instancji postgres) ===
# DMS_SERVICE_DB_USER - rola bazy danych tworzona przez pg-init dla dms_service (schema "dms"); wymagane
# DMS_SERVICE_DB_PASSWORD - hasło tej roli (SPRING_DATASOURCE_PASSWORD dms_service); wymagane, zmienić na serwerze
DMS_SERVICE_DB_USER=dms_service
DMS_SERVICE_DB_PASSWORD=change-me

# === sign_service (rola/schema "pki" w instancji postgres) ===
# SIGN_SERVICE_DB_USER - rola bazy danych tworzona przez pg-init dla sign_service (schema "pki"); wymagane
# SIGN_SERVICE_DB_PASSWORD - hasło tej roli (SPRING_DATASOURCE_PASSWORD sign_service); wymagane, zmienić na serwerze
SIGN_SERVICE_DB_USER=sign_service
SIGN_SERVICE_DB_PASSWORD=change-me

# === delivery_mock (rola/schema "delivery" w instancji postgres) ===
# DELIVERY_MOCK_DB_USER - rola bazy danych tworzona przez pg-init dla delivery_mock (schema "delivery"); wymagane
# DELIVERY_MOCK_DB_PASSWORD - hasło tej roli (SPRING_DATASOURCE_PASSWORD delivery_mock); wymagane, zmienić na serwerze
DELIVERY_MOCK_DB_USER=delivery_mock
DELIVERY_MOCK_DB_PASSWORD=change-me

# === delivery_mock -> document_api (klient serwisowy Keycloak, client-credentials) ===
# DELIVERY_MOCK_SERVICE_CLIENT_SECRET - sekret klienta "delivery-mock-service" w realmie
# document-workflow (service account, rola "kancelaria"); wymagane, zmienić na serwerze
DELIVERY_MOCK_SERVICE_CLIENT_SECRET=change-me

# === RabbitMQ (kontener "rabbitmq", kolejki zdarzeń/akcji zbiorowych) ===
# RABBITMQ_USER - użytkownik brokera (RABBITMQ_DEFAULT_USER); wymagane
# RABBITMQ_PASSWORD - hasło tego użytkownika (RABBITMQ_DEFAULT_PASS); wymagane, zmienić na serwerze
RABBITMQ_USER=edws
RABBITMQ_PASSWORD=change-me

# === Keycloak (kontener "keycloak", rola/schema "keycloak" w instancji postgres) ===
# KEYCLOAK_DB_USER - rola bazy danych tworzona przez pg-init dla Keycloaka (schema "keycloak"); wymagane
# KEYCLOAK_DB_PASSWORD - hasło tej roli (KC_DB_PASSWORD); wymagane, zmienić na serwerze
# KEYCLOAK_ADMIN_USERNAME - konto administratora konsoli Keycloak (KC_BOOTSTRAP_ADMIN_USERNAME); wymagane
# KEYCLOAK_ADMIN_PASSWORD - hasło konta administratora (KC_BOOTSTRAP_ADMIN_PASSWORD); wymagane, zmienić na serwerze
# KEYCLOAK_DEMO_USER_PASSWORD - wspólne hasło 4 użytkowników demo zaimportowanych do realmu document-workflow; wymagane, zmienić na serwerze
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DEMO_USER_PASSWORD=change-me

# === Porty hosta (opcjonalne - domyślne wartości w compose.yml / compose.dev.yml) ===
# DOCUMENT_WEB_HOST_PORT - port hosta dla document_web; domyślnie (brak wartości) = 10600
# DOCUMENT_API_HOST_PORT - port hosta dla document_api; domyślnie (brak wartości) = 10620
# DMS_SERVICE_HOST_PORT - port hosta dla dms_service (tylko compose.dev.yml); domyślnie (brak wartości) = 10621
# JASPER_SERVICE_HOST_PORT - port hosta dla jasper_service (tylko compose.dev.yml); domyślnie (brak wartości) = 10622
# SIGN_SERVICE_HOST_PORT - port hosta dla sign_service (tylko compose.dev.yml); domyślnie (brak wartości) = 10623
# DELIVERY_MOCK_HOST_PORT - port hosta dla delivery_mock; domyślnie (brak wartości) = 10624
# RABBITMQ_AMQP_HOST_PORT - port hosta dla protokołu AMQP RabbitMQ (tylko compose.dev.yml); domyślnie (brak wartości) = 10670
# RABBITMQ_UI_HOST_PORT - port hosta dla UI zarządzania RabbitMQ (tylko compose.dev.yml); domyślnie (brak wartości) = 10671
# EDWS_DB_HOST_PORT - port hosta dla postgres (tylko compose.dev.yml); domyślnie (brak wartości) = 10680
# KEYCLOAK_HOST_PORT - port hosta dla Keycloaka; domyślnie (brak wartości) = 10681
#DOCUMENT_WEB_HOST_PORT=10600
#DOCUMENT_API_HOST_PORT=10620
#DMS_SERVICE_HOST_PORT=10621
#JASPER_SERVICE_HOST_PORT=10622
#SIGN_SERVICE_HOST_PORT=10623
#DELIVERY_MOCK_HOST_PORT=10624
#RABBITMQ_AMQP_HOST_PORT=10670
#RABBITMQ_UI_HOST_PORT=10671
#EDWS_DB_HOST_PORT=10680
#KEYCLOAK_HOST_PORT=10681

# === Publiczne URL-e (dopisywane do konfiguracji klienta OIDC document-web / issuera Keycloaka) ===
# DOCUMENT_WEB_PUBLIC_URL - publiczny adres document_web widziany przez przeglądarkę; domyślnie (brak wartości) = http://localhost:10600
# KEYCLOAK_PUBLIC_URL - publiczny adres Keycloaka (KC_HOSTNAME, issuer OIDC); domyślnie (brak wartości) = http://localhost:10681
#DOCUMENT_WEB_PUBLIC_URL=http://localhost:10600
#KEYCLOAK_PUBLIC_URL=http://localhost:10681
